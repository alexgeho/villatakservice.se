# villatakservice.se — SEO/canonical redirects (LiteSpeed/Apache)
# Löser GSC "Duplicate without user-selected canonical" genom att
# tvinga EN kanonisk URL-form: https + icke-www + / (utan /index.html).

RewriteEngine On

# 1+2) http och/eller www -> https://villatakservice.se i ETT hopp
# (tidigare http://www -> https://www -> https:// = två hopp).
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://villatakservice.se%{REQUEST_URI} [R=301,L]

# 3) Redirecta /index.html -> / (undvik dubblettadress)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 4) Gamla borttagna sidor (404 i GSC) -> närmaste aktuella sida (301)
RewriteRule ^takrenovering-stockholm\.html$ /takrenovering.html [R=301,L]
RewriteRule ^takreparation-stockholm\.html$ /takrenovering.html [R=301,L]
RewriteRule ^bygg-renovering\.html$ /villarenovering.html [R=301,L]

# README.md ligger kvar på servern från tidiga deployer (FTP raderar inte).
<Files "README.md">
  Require all denied
</Files>

# Egen 404-sida (live visade LiteSpeeds standardsida).
ErrorDocument 404 /404.html

# ---- Säkerhetsheaders ----
<IfModule mod_headers.c>
  # HSTS: tvinga HTTPS i webbläsaren i 1 år (endast efter att https bekräftats funka)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- Grundläggande caching för statiska resurser ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
